{
  "name": "Laravel + Angular Dev",
  "dockerComposeFile": "docker-compose.yml",
  "service": "app",
  "workspaceFolder": "/workspaces/${localWorkspaceFolderBasename}",
  "features": {
    "ghcr.io/devcontainers/features/node:1": { "version": "20" }
  },
  "postCreateCommand": "npm install -g @angular/cli && composer global require laravel/installer && echo 'export PATH=\"$PATH:$HOME/.composer/vendor/bin\"' >> ~/.bashrc",
  "forwardPorts": [8000, 4200, 5432],
  "portsAttributes": {
    "8000": { "label": "Laravel API", "onAutoForward": "notify" },
    "4200": { "label": "Angular App", "onAutoForward": "openBrowser" },
    "5432": { "label": "PostgreSQL" }
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "angular.ng-template",
        "bmewburn.vscode-intelephense-client",
        "ryannaddy.laravel-artisan"
      ]
    }
  }
}
